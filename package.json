{
  "name": "those-days-vrchat-memorial",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "tsc -b --noEmit",
    "album:manifest": "node tools/album-manifest/generate-manifest.js --in VRChat --out public/albums/manifest.json --file-prefix VRChat",
    "album:admin-key": "node tools/generate-admin-key.mjs",
    "test:album-empty": "node tools/album-empty-storage-test.mjs",
    "test:album-access": "node tools/album-access-test.mjs",
    "test:image-size": "node tools/image-size-test.mjs",
    "test:album-delete": "node tools/album-delete-test.mjs",
    "test:album-zone-change": "node tools/album-zone-change-test.mjs",
    "test:session-persist": "node tools/session-persist-test.mjs",
    "test:key-fingerprint": "node tools/key-fingerprint-test.mjs",
    "test:album-metadata": "node tools/album-metadata-test.mjs"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.2.7",
    "ali-oss": "^6.23.0",
    "clsx": "^2.1.1",
    "i18next": "^25.8.18",
    "jszip": "^3.10.1",
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.8",
    "react-router-dom": "^7.3.0",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4"
  }
